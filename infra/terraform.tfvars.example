cloudflare_account_id = "00000000000000000000000000000000"

# staging / prod を同じ state で管理する。
enabled_environments = ["staging", "prod"]

# 中央 infrastructure repository が管理している JIZI Portal OIDC など、
# ログインと管理 API へのアクセスを許可する既存 Identity Provider の ID。
allowed_identity_provider_ids = [
  "00000000-0000-0000-0000-000000000000",
]

session_duration = "24h"

# ブラウザを持たない CI / 外部システム用の service token。
service_token_duration = "8760h"

# secret を再発行するときだけ 1 から順に増やす。
# service_token_secret_version = 1
