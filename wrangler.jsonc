{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "events-api-2026",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  // Access はカスタムドメインのルートにしか掛からないため、
  // workers.dev の裏口を塞いでおく。
  "workers_dev": false,
  "route": {
    "custom_domain": true,
    "pattern": "events26.koudaisai.jp",
  },
  "env": {
    "staging": {
      "route": {
        "custom_domain": true,
        "pattern": "events26-staging.koudaisai.jp",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "events-api-2026-staging",
          "database_id": "b4e851c0-fb6b-48e8-be1b-c7805cbc0780",
        },
      ],
      "vars": {
        // TODO: Access のチームドメインと、管理用アプリの AUD タグを入れる
        "ACCESS_TEAM_DOMAIN": "https://jizi-isct.cloudflareaccess.com",
        "ACCESS_AUD": "310daeb3f02173ca85528afb56015715b1ea5c2f0debc3b51684d4e06a023f48",
      },
    },
    "prod": {
      "route": {
        "custom_domain": true,
        "pattern": "events26.koudaisai.jp",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "events-api-2026-prod",
          "database_id": "eedea329-37af-4baa-ba98-2a4c52bb9441",
        },
      ],
      "vars": {
        // TODO: Access のチームドメインと、管理用アプリの AUD タグを入れる
        "ACCESS_TEAM_DOMAIN": "https://CHANGEME.cloudflareaccess.com",
        "ACCESS_AUD": "CHANGEME",
      },
    },
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}
