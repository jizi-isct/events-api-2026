{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "events-api-2026",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  // named environment だけが custom domain を所有する。default Worker は
  // deploy されても公開されないよう workers.dev の裏口を塞いでおく。
  "workers_dev": false,
  "env": {
    "staging": {
      "route": {
        "custom_domain": true,
        "pattern": "events26-staging.koudaisai.jp",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "events-api-2026-staging",
          "database_id": "b4e851c0-fb6b-48e8-be1b-c7805cbc0780",
        },
      ],
      "r2_buckets": [
        {
          // Terraform の wrangler_r2_buckets.staging と同期する。
          "binding": "ICON_BUCKET",
          "bucket_name": "events-api-2026-icons-staging",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "vars": {
        // Terraform の wrangler_access_vars.staging と同期する。
        "ACCESS_TEAM_DOMAIN": "https://jizi-isct.cloudflareaccess.com",
        "ACCESS_AUD": "310daeb3f02173ca85528afb56015715b1ea5c2f0debc3b51684d4e06a023f48",
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
    },
    "prod": {
      "route": {
        "custom_domain": true,
        "pattern": "events26.koudaisai.jp",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "events-api-2026-prod",
          "database_id": "eedea329-37af-4baa-ba98-2a4c52bb9441",
        },
      ],
      "r2_buckets": [
        {
          // Terraform の wrangler_r2_buckets.prod と同期する。
          "binding": "ICON_BUCKET",
          "bucket_name": "events-api-2026-icons-prod",
        },
      ],
      "images": {
        "binding": "IMAGES",
      },
      "vars": {
        // Terraform の wrangler_access_vars.prod と同期する。
        "ACCESS_TEAM_DOMAIN": "https://jizi-isct.cloudflareaccess.com",
        "ACCESS_AUD": "ec3bdff1fa3818da428e501c7a7c54d415c51bb3998452d9c04730f9d0265bc4",
      },
      "observability": {
        "enabled": true,
        "head_sampling_rate": 1,
      },
    },
  },
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  // "vars": {
  //   "MY_VAR": "my-variable"
  // },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // "r2_buckets": [
  //   {
  //     "binding": "MY_BUCKET",
  //     "bucket_name": "my-bucket"
  //   }
  // ],
  // "d1_databases": [
  //   {
  //     "binding": "MY_DB",
  //     "database_name": "my-database",
  //     "database_id": ""
  //   }
  // ],
  // "ai": {
  //   "binding": "AI"
  // },
}
